<section class="hero is-light is-fullheight">
  <div class="hero-head">
    <nav class="column">
      <%= button_to "Logout", app_v2_session_path(1), method: :delete, class: "is-pulled-right button is-small is-light is-inverted is-outlined" %>
    </nav>
  </div>
  <div class="hero-body">
    <div data-controller="electron sync" class="container" data-electron-minimal-stretchly-version-value="<%= ENV['MIN_STRETCHLY_VERSION'] %>">
      <div data-electron-target="loader" class="has-text-centered">
        <div class="is-flex is-flex-direction-column is-align-items-center is-justify-content-center" style="min-height: 200px;">
          <button class="button is-large is-light is-loading"></button>
          <p class="has-text-grey-light mt-4">Loading Stretchly...</p>
        </div>
      </div>
      <div data-electron-target="visible">
        <h1 class="title">Sync Preferences</h1>
        <div data-electron-target="unsupported" class="notification is-warning">
          Looks like you are using an unsupported version of Stretchly. This might not work.
        </div>
        <div class="content">
          <p>
            Sync is experimental. You can save your preferences to your account and restore them later.
            We recommend using the same version of Stretchly for backup and restore.
          </p>
          <p>
            Where preferences differ, values from <span class="has-text-primary">this device</span>
            appear in green and values from your <span class="has-text-info">saved backup</span> in blue.
          </p>
        </div>
        <div class="buttons">
          <button type="button" data-action="click->sync#backup" class="button is-primary">Backup</button>
          <% if current_user.setting.present? %>
            <button type="button" data-action="click->sync#restore" class="button is-info">Restore</button>
          <% end %>
          <%= link_to "Refresh Data", app_v2_sync_path, class: "button is-success" %>
        </div>
        <div class="box">
          <dl class="columns">
            <div class="column">
              <dt class="has-text-primary has-text-weight-semibold">This device</dt>
              <dd>Running Stretchly <span data-electron-target="version">…</span></dd>
            </div>
            <div class="column">
              <dt class="has-text-info has-text-weight-semibold">Saved backup</dt>
              <% if current_user.setting.present? %>
                <dd>
                  <% if current_user.setting.stretchly_version.present? %>
                    Created with Stretchly <%= current_user.setting.stretchly_version %>
                  <% else %>
                    Stretchly version wasn't recorded
                  <% end %>
                </dd>
                <dd class="is-size-7">Saved <%= current_user.setting.updated_at.utc.strftime("%d %b %Y at %H:%M UTC") %></dd>
              <% else %>
                <dd>No backup yet</dd>
              <% end %>
            </div>
          </dl>
        </div>
        <div data-sync-target="settings" id="settings" class="content"></div>
      </div>
    </div>
  </div>
  <%= render "shared/footer_v1" %>
</section>
